# Application
APP_NAME=Extrai Leads
APP_ENV=development
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Database (use postgresql+asyncpg://user:password@host/database in production)
DATABASE_URL=sqlite+aiosqlite:///./data/extrais_leads.db
DATABASE_ECHO=false
DATABASE_AUTO_CREATE=false

# Frontend origins must be a JSON array
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Cache and provider safety limits
CACHE_DEFAULT_TTL_SECONDS=86400
CACHE_MAX_ENTRIES=10000
SEARCH_BACKGROUND_ENABLED=true
SEARCH_QUERY_VARIATIONS=4
PROVIDER_TIMEOUT_SECONDS=45
PROVIDER_MAX_CONCURRENCY=3
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BASE_SECONDS=1
PROVIDER_MAX_PAGES=10
PROVIDER_MAX_ITEMS=5000

# OpenStreetMap: identify your deployment; a contact e-mail is strongly recommended.
OSM_ENABLED=true
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_USER_AGENT=ExtraiLeads/0.5
OSM_CONTACT_EMAIL=
OSM_REQUEST_INTERVAL_SECONDS=1

# Public website enrichment. Crawling is same-origin, robots-aware and bounded.
PHONE_DEFAULT_REGION=BR
WEBSITE_ENRICHMENT_ENABLED=true
WEBSITE_ENRICHMENT_MAX_COMPANIES=250
WEBSITE_ENRICHMENT_MAX_PAGES_PER_SITE=3
WEBSITE_ENRICHMENT_MAX_BYTES_PER_PAGE=1000000
WEBSITE_ENRICHMENT_MAX_REDIRECTS=3
WEBSITE_ENRICHMENT_CONCURRENCY=4
WEBSITE_ENRICHMENT_TIMEOUT_SECONDS=15
WEBSITE_ENRICHMENT_REQUEST_INTERVAL_SECONDS=0.5
WEBSITE_ENRICHMENT_CACHE_TTL_SECONDS=604800
WEBSITE_ENRICHMENT_USER_AGENT=ExtraiLeads/0.5
WEBSITE_ENRICHMENT_RESPECT_ROBOTS=true

# Excel export reads the database in bounded batches and writes in streaming mode.
EXCEL_EXPORT_BATCH_SIZE=500

# Tavily is optional. Never commit real credentials.
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_MAX_RESULTS_PER_QUERY=20
TAVILY_API_KEY=

# Optional, evidence-only category qualification. Public business text is
# minimized before sending; contact data, CNPJ and addresses are never sent.
AI_QUALIFICATION_ENABLED=true
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=1
GEMINI_RETRY_BASE_SECONDS=1
GEMINI_MAX_QUALIFICATIONS_PER_SEARCH=25
GEMINI_QUALIFICATION_BATCH_SIZE=10
GEMINI_CACHE_TTL_SECONDS=604800
GEMINI_API_KEY=
